# Copia este archivo a .env (cp .env.example .env). Nunca subas .env al repo.

# API
HOST=0.0.0.0
PORT=3000

# Postgres (docker-compose)
POSTGRES_USER=turnos
POSTGRES_PASSWORD=turnos
POSTGRES_DB=turnos
DATABASE_URL=postgres://turnos:turnos@localhost:5432/turnos

# Email en local: Mailpit (bandeja en http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
